{
  "name": "@neuroverseos/robot-domain-rules",
  "version": "0.4.0",
  "description": "Rules for spaces shared by people, robots and AI: a declared-authority rulebook, a deterministic may-I decision with its reasons, conflict detection, signed approvals, and a language-neutral spec with conformance tests.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "examples/*.ts",
    "examples/harness",
    "examples/mcp/server.ts",
    "examples/mcp/package.json",
    "examples/mcp/tsconfig.json",
    "examples/mcp/README.md",
    "spec",
    "conformance/*.json",
    "conformance/rulebooks",
    "conformance/compare.mjs",
    "conformance/compare.d.mts",
    "conformance/run-node.mjs",
    "conformance/README.md",
    "README.md",
    "PRINCIPLES.md",
    "SPEC.md",
    "BOUNDARY.md",
    "RELATED-WORK.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run --dir test",
    "typecheck": "tsc --noEmit",
    "demo": "tsx examples/demo.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run conformance",
    "site": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:test": "npm --prefix site test",
    "conformance": "node conformance/run-node.mjs",
    "conformance:generate": "tsx conformance/generate.ts",
    "replay": "tsx examples/harness/replay.ts"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "robotics",
    "smart-glasses",
    "ai-agents",
    "governance",
    "authorization",
    "rules",
    "posemesh",
    "spatial-computing",
    "conformance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeuroverseOS/robot-domain-rules.git"
  },
  "homepage": "https://neuroverseos.github.io/robot-domain-rules/",
  "bugs": {
    "url": "https://github.com/NeuroverseOS/robot-domain-rules/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
