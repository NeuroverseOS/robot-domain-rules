{
  "name": "@neuroverseos/robot-domain-rules",
  "version": "0.3.1",
  "description": "A governance core for physical spaces: turn any site's answers and plain-language rules into one rulebook, flag rules that conflict, and let robots, glasses and AI agents ask before they act.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run --dir test",
    "typecheck": "tsc --noEmit",
    "demo": "tsx examples/demo.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "site": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:test": "npm --prefix site test"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "robotics",
    "smart-glasses",
    "governance",
    "rules",
    "posemesh",
    "spatial-computing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeuroverseOS/robot-domain-rules.git"
  },
  "homepage": "https://neuroverseos.github.io/robot-domain-rules/",
  "bugs": {
    "url": "https://github.com/NeuroverseOS/robot-domain-rules/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
