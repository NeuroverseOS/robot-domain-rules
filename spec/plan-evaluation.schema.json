{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroverseos.github.io/robot-domain-rules/spec/plan-evaluation.schema.json",
  "title": "Plan evaluation (robot-domain-rules/3)",
  "description": "The verdict on a plan: every evaluated step with its decision, the plan rules' verdicts, the first violation, the approvals needed, the final facts. SPEC.md § 12.",
  "type": "object",
  "required": [
    "status",
    "steps",
    "planChecks",
    "approvalRequests",
    "finalFacts",
    "finalArea",
    "planDigest",
    "fingerprint"
  ],
  "properties": {
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "steps": {
      "type": "array",
      "description": "In order, up to and including the first BLOCK.",
      "items": {
        "type": "object",
        "required": [
          "index",
          "action",
          "areaId",
          "facts",
          "decision"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string"
          },
          "areaId": {
            "type": "string"
          },
          "facts": {
            "type": "object"
          },
          "decision": {
            "$ref": "decision.schema.json"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "planChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ruleId",
          "status",
          "reason",
          "setBy"
        ],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ALLOW",
              "BLOCK"
            ]
          },
          "reason": {
            "type": "string"
          },
          "setBy": {
            "type": "string"
          },
          "stepIndex": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "firstViolation": {
      "type": "object",
      "required": [
        "stepIndex",
        "ruleId",
        "reason",
        "setBy",
        "from"
      ],
      "properties": {
        "stepIndex": {
          "type": "integer",
          "minimum": 0
        },
        "ruleId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "setBy": {
          "type": "string"
        },
        "from": {
          "enum": [
            "step",
            "plan"
          ]
        }
      }
    },
    "approvalRequests": {
      "type": "array",
      "items": {
        "$ref": "approval.schema.json#/$defs/approvalRequest"
      }
    },
    "finalFacts": {
      "type": "object"
    },
    "finalArea": {
      "type": "string"
    },
    "planDigest": {
      "$ref": "common.schema.json#/$defs/fingerprint",
      "description": "fingerprint of the plan with every approvedBy and consumedApprovals left out."
    },
    "fingerprint": {
      "$ref": "common.schema.json#/$defs/fingerprint"
    }
  },
  "additionalProperties": false
}
