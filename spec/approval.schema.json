{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroverseos.github.io/robot-domain-rules/spec/approval.schema.json",
  "title": "Approvals (robot-domain-rules/1)",
  "description": "What a PAUSE asks for, and what a person signs. SPEC.md § Approvals.",
  "$defs": {
    "approvalRequest": {
      "type": "object",
      "required": ["ruleId", "requestDigest", "rulebookFingerprint", "reason", "setBy"],
      "properties": {
        "ruleId": { "type": "string" },
        "by": { "type": "string", "description": "An authority ID (that or higher), a role ID, or tag:<role tag>. Absent: anyone." },
        "requestDigest": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "rulebookFingerprint": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "reason": { "type": "string" },
        "setBy": { "type": "string" }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "description": "facts.approvedBy as an object. Plain { id, authority?, roleId? } is accepted only when the rulebook declares no trustedKeys.",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "authority": { "type": "string" },
        "roleId": { "type": "string" },
        "verified": { "type": "boolean", "description": "Set by the caller's verifyApproval only after the signature checked out." },
        "requestDigest": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "rulebookFingerprint": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "keyId": { "type": "string" },
        "issuedAt": { "type": "string" },
        "signature": { "$ref": "common.schema.json#/$defs/hex64" }
      }
    },
    "signedApproval": {
      "type": "object",
      "required": ["id", "requestDigest", "rulebookFingerprint", "issuedAt", "keyId", "signature"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "authority": { "type": "string" },
        "roleId": { "type": "string" },
        "requestDigest": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "rulebookFingerprint": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "issuedAt": { "type": "string", "description": "ISO 8601. Not checked by the evaluator." },
        "keyId": { "type": "string", "minLength": 1 },
        "signature": { "$ref": "common.schema.json#/$defs/hex64", "description": "Ed25519 over the UTF-8 canonical JSON of every other field." }
      },
      "additionalProperties": false
    },
    "trustedKey": {
      "type": "object",
      "required": ["keyId", "publicKey"],
      "properties": {
        "keyId": { "$ref": "common.schema.json#/$defs/id" },
        "publicKey": { "$ref": "common.schema.json#/$defs/hex32" },
        "authority": { "type": "string" },
        "roleId": { "type": "string" }
      }
    },
    "rulebookSignature": {
      "type": "object",
      "required": ["keyId", "fingerprint", "signature"],
      "properties": {
        "keyId": { "type": "string" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "signature": { "$ref": "common.schema.json#/$defs/hex64", "description": "Ed25519 over the UTF-8 canonical JSON of the whole rulebook, fingerprint included." }
      }
    }
  }
}
