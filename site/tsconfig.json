{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "test/**/*", "vite.config.ts", "../src/**/*.ts", "../examples/grocery-store.ts", "../examples/warehouse.ts", "../examples/clinic.ts", "../examples/backtest/rulebook.ts", "../examples/backtest/sample-week.ts"]
}
